{
  "$schema": "https://opencode.ai/config.json",
  //--------------------------------------------------------------------------------
  // CORE MODEL & ROUTING
  //--------------------------------------------------------------------------------
  // "model": "opencode/x-preview-f-free",
  // "small_model": "ollama/qwen3.5:4b",
  "default_agent": "plan",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  //--------------------------------------------------------------------------------
  // REFERENCES
  //--------------------------------------------------------------------------------
  "references": {
    "ag": {
      "path": "~/agents",
      "description": "Agents library"
    }
  },
  //--------------------------------------------------------------------------------
  // PLUGINS
  //--------------------------------------------------------------------------------
  // "plugin": [
  //   "opencode-snip@latest"
  // ],
  //--------------------------------------------------------------------------------
  // LOCAL PROVIDERS (OLLAMA)
  //--------------------------------------------------------------------------------
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {},
        "qwen3.5:9b-q4_K_M": {},
        "Qwen3.8-27B-UD-IQ3_XXS:latest": {}
      }
    }
  },
  //--------------------------------------------------------------------------------
  // AGENT BEHAVIORS & LIMITS
  //--------------------------------------------------------------------------------
  "agent": {
    "build": {
      // "variant": "max",
      "steps": 32,
      "color": "#CBA6F7"
    },
    "plan": {
      // "variant": "high",
      "steps": 16,
      "color": "#EBCB8B"
    },
    "explore": {
      "steps": 8
    },
    "general": {
      "steps": 8
    },
    "compaction": {
      "steps": 8
    },
    "title": {
      // "variant": "low",
      // "steps": 2
      "enabled": false
    },
    "summary": {
      // "variant": "low",
      // "steps": 2
      "enabled": false
    }
  },
  //--------------------------------------------------------------------------------
  // SECURITY & GUARDRAILS
  //--------------------------------------------------------------------------------
  "permission": {
    "external_directory": {
      // Sys dirs
      "/tmp/**": "allow",
      // Home dirs
      "~/wip/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/dev/dani/**": "allow",
      "~/agents/**": "allow"
    },
    "read": {
      // Secrets & Configs
      "*.env": "deny",
      "*.env.*": "deny",
      "**/Dockerfile*": "ask",
      // Infrastructure as Code
      "**/*.tf": "deny",
      "**/*.tfvars": "deny",
      "terraform/**": "deny",
      ".github/workflows/**": "deny",
      ".gitlab-ci.yml": "deny",
      "k8s/**": "deny",
      "helm/**": "deny"
    },
    "bash": {
      // Privilege Escalation
      "sudo *": "deny",
      "su -*": "deny",
      // Destructive Actions
      "rm *": "ask",
      // Git Mutations
      "git commit*": "deny",
      "git push*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      // Databases
      "psql*": "ask",
      "sqlite*": "ask",
      "mysql*": "ask",
      // Package Managers
      "uv *": "ask",
      "pip *": "ask",
      "poetry *": "ask",
      // Global Execution Denies
      "make*": "deny",
      "cmake*": "deny",
      "g++*": "deny",
      "clang*": "deny",
      "gcc*": "deny",
      "ninja*": "deny",
      "go *": "deny",
      "cargo *": "deny",
      "rustc *": "deny",
      "odin *": "deny",
      "zig *": "deny",
      "python*": "ask",
      "python3*": "ask"
    }
  },
  //--------------------------------------------------------------------------------
  // CONTEXT & MEMORY MANAGEMENT
  //--------------------------------------------------------------------------------
  "compaction": {
    "prune": true
  },
  "watcher": {
    "ignore": [
      // IDE & Caches
      ".git/**",
      ".cache/**",
      ".clangd/**",
      ".vs/**",
      ".vscode/**",
      ".idea/**",
      // Build Outputs
      "build/**",
      "build-*/**",
      "cmake-build-*/**",
      "CMakeFiles/**",
      "CMakeCache.txt",
      "bin/**",
      "out/**",
      "dist/**",
      "coverage/**",
      ".next/**",
      // C/C++ Artifacts
      "**/*.o",
      "**/*.obj",
      "**/*.d",
      "**/*.o.d",
      "**/*.a",
      "**/*.lib",
      "**/*.so",
      "**/*.so.*",
      "**/*.dylib",
      "**/*.dll",
      "**/*.exe",
      // Rust / Cargo
      "target/**",
      "Cargo.lock",
      // Python
      "__pycache__/**",
      "**/*.pyc",
      ".venv/**",
      "venv/**",
      // Zig
      ".zig-cache/**",
      "zig-out/**",
      // Node
      "node_modules/**",
      // IaC
      "**/*.tf",
      "**/*.tfvars",
      "terraform/**",
      ".github/workflows/**",
      ".gitlab-ci.yml",
      "k8s/**",
      "helm/**"
    ]
  },
  //--------------------------------------------------------------------------------
  // APPLICATION & PRIVACY SETTINGS
  //--------------------------------------------------------------------------------
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "autoupdate": false,
  //--------------------------------------------------------------------------------
  // APPLICATION & PRIVACY SETTINGS
  //--------------------------------------------------------------------------------
  "experimental": {
    "batch_tool": true, // This could save tokens
    "continue_loop_on_deny": false
  }
}