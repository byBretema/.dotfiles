{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["~/.config/opencode/AGENTS.md"],

  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/agents/**": "allow",
      "~/dev/dani/**": "allow"
    }
  },

  "lsp": false,
  "formatter": false,
  "autoupdate": false,
  "compaction": { "prune": false },

  "share": "disabled",

  "model": "opencode/x-preview-f-free",

  "agent": {
    "build": { "variant": "max" },
    "plan": { "variant": "high" },
    "explore": { "variant": "default" },
    "general": { "variant": "default" },
    "compaction": { "variant": "default" },
    "title": { "variant": "low" },
    "summary": { "variant": "low" }
  },

  "experimental": {
    "batch_tool": false,
    "continue_loop_on_deny": false
  }
}
