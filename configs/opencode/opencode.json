{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "variant": "max"
    },
    "explore": {
      "variant": "max"
    },
    "general": {
      "variant": "max"
    },
    "plan": {
      "variant": "max"
    }
  },
  "autoupdate": false,
  "compaction": {
    "prune": false
  },
  "experimental": {
    "batch_tool": false,
    "continue_loop_on_deny": false
  },
  "formatter": false,
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "lsp": false,
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/agents/**": "allow",
      "~/dev/dani/**": "allow"
    }
  },
  "plugin": [
    // "./plugin/auto-agents.ts"
  ],
  "provider": {},
  "share": "disabled"
}
