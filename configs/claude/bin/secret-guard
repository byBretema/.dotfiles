#!/usr/bin/env sh
# PreToolUse hook (Bash): Read() deny rules miss grep -r, scripts and globs; block the same secret paths here.
# Matches paths, not tools, so any reader is covered. Still a habit guard: paths built at runtime
# (string concatenation, base64, $vars) or reached via `cd` + relative glob get through.

command -v jq >/dev/null 2>&1 || exit 0
# Drop quotes and backslashes so .s"s"h and .s\sh match; drop public keys, the one thing allowed under .ssh.
cmd=$(jq -r '.tool_input.command // empty' | tr -d "\"'\\\\" |
    sed -E 's#(\.ssh/)?[[:alnum:]_.-]+\.pub([^[:alnum:]_.-]|$)#\2#g')

b='([^[:alnum:]_.-]|$)'
dirs='\.ssh|\.gnupg|\.aws|\.kube|\.azure|\.password-store|\.config/gcloud|share/keyrings'
files='\.git-credentials|\.netrc|\.npmrc|\.pypirc|gh/hosts\.yml|atuin/key|\.credentials\.json|opencode/auth\.json|\.docker/config\.json|id_(rsa|dsa|ecdsa|ed25519)(_sk)?|[^[:space:]/]*\.(pem|key|p12|pfx|kdbx)'
# Globs that could expand to the above: a hidden name under home, or a private-key name.
home='(~|\$\{?HOME\}?|/home/[^/[:space:]]+)'
globs="$home/(\.[^/[:space:]]*|\.config/[^/[:space:]]*|\.local/share/[^/[:space:]]*)[]*?[]|(^|[^[:alnum:]_])id_[^/[:space:]]*[]*?[]"

if printf '%s\n' "$cmd" | grep -qE "(^|[^[:alnum:]_])($dirs)$b|(^|[^[:alnum:]_])($files)$b|$globs"; then
    echo 'secret-guard: command touches a credential/key path; ask the user to run it instead' >&2
    exit 2
fi
exit 0
