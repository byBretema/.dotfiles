#!/usr/bin/env sh
# PreToolUse hook (Bash): Read() deny rules don't cover shell commands, so block the same secret paths here.
# A habit guard, not a sandbox: anything obfuscated enough gets through.

command -v jq >/dev/null 2>&1 || exit 0
cmd=$(jq -r '.tool_input.command // empty')

# private keys only: id_* followed by .pub stays allowed
secrets='\.ssh/id_[[:alnum:]_]+([^.[:alnum:]_]|$)|\.gnupg/|\.aws/(credentials|config)|\.git-credentials|\.netrc|gh/hosts\.yml|atuin/key|\.claude/\.credentials\.json|opencode/auth\.json|\.docker/config\.json|\.npmrc|share/keyrings/|\.(pem|key|p12|pfx)([^[:alnum:]_]|$)'

if printf '%s\n' "$cmd" | grep -qE "$secrets"; then
    echo 'secret-guard: command touches a credential/key path; ask the user to run it instead' >&2
    exit 2
fi
exit 0
