{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.ssh/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.git-credentials)",
      "Read(//**/.netrc)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.local/share/atuin/key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.docker/config.json)",
      "Read(//**/.npmrc)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.password-store/**)",
      "Read(//**/.pypirc)",
      "Read(//**/*.kdbx)"
    ],
    "ask": [
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*.tfvars)",
      "Read(**/.github/workflows/**)",
      "Read(**/.gitlab-ci.yml)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(psql *)",
      "Bash(sqlite *)",
      "Bash(sqlite3 *)",
      "Bash(mysql *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(poetry *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "~/agents",
      "~/.dotfiles",
      "~/me",
      "~/poet",
      "~/omi/code"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/bin/rm-guard ] || exit 0; exec ~/.claude/bin/rm-guard"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/bin/secret-guard ] || exit 0; exec ~/.claude/bin/secret-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/bin/notify ] || exit 0; exec ~/.claude/bin/notify"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/bin/notify ] || exit 0; exec ~/.claude/bin/notify"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.claude/bin/memory-audit ] || exit 0; exec ~/.claude/bin/memory-audit"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    }
  },
  "askUserQuestionTimeout": "60s",
  "tui": "fullscreen",
  "timeFormat": "auto",
  "theme": "auto",
  "editorMode": "normal",
  "remoteControlAtStartup": false,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/configs/claude/plugins/footer-tail"
  },
  "outputStyle": "terse",
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
