#!/usr/bin/env bash
# CMake compiler launcher (set by poet-launch). Every folder under ~/poet is a base dir,
# so the POET worktrees share cache hits despite their different absolute paths. The
# sccache server keeps the base dirs it started with: after adding a worktree, run
# "sccache --stop-server".
#
# Ninja compiles from the build folder, inside the worktree, so the sccache bundled in
# that worktree's POET/BuildSystem is found walking up from $PWD; else the one on PATH.
bin=sccache
d=$PWD
while [[ $d == "$HOME/poet/"* ]]; do
    for b in "$d"/POET/BuildSystem/sccache-*-unknown-linux-musl/sccache; do
        [[ -x $b ]] && { bin=$b; break 2; }
    done
    d=${d%/*}
done

dirs=("$HOME"/poet/*/)
dirs=("${dirs[@]%/}")
IFS=:
export SCCACHE_BASEDIRS="${SCCACHE_BASEDIRS:-${dirs[*]}}"
exec "$bin" "$@"
