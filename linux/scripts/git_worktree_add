#!/usr/bin/env bash

target_file="/tmp/git_worktree_add_target"
rm -f "$target_file"

source ".bash_common"
if ! is_git; then
  for dir in main master dev; do
    [[ -d "$dir/.git" ]] || [[ -f "$dir/.git" ]] && cd "$dir" && exec "$script_path/$script_name" "$@"
  done
  error_exit "not a git repository"
fi

MAX_HEIGHT=12

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
parent_dir=$(dirname "$repo_root")

get_branches() {
  git branch -a --format='%(refname:short)' |
    sed 's|^origin/||'                      |
    grep -v '^HEAD$'                        |
    sort -u
}

selection="$1"
if [[ -z "$selection" ]]; then

  entries=$(get_branches)
  count=$(echo "$entries" | grep -c .)
  height=$(( (count < MAX_HEIGHT ? count : MAX_HEIGHT) + 3 ))

  echo
  selection=$(gum filter --height=$height --header="▌ git worktree add" --placeholder="Choose a branch..." <<< "$entries")
  [[ -z "$selection" ]] && {
    selection=$(gum input --placeholder " New branch name...")
    [[ -z "$selection" ]] && gum style "cancelled" && exit 1
  }
fi

target="$parent_dir/$selection"

if git rev-parse --verify --quiet "refs/heads/$selection" >/dev/null 2>&1; then
  gum style "existing branch: $selection"
  git worktree add "$target" "$selection"
elif git rev-parse --verify --quiet "refs/remotes/origin/$selection" >/dev/null 2>&1; then
  gum style "remote branch: $selection"
  git worktree add "$target" "origin/$selection"
else
  gum style "new branch: $selection"
  git worktree add -b "$selection" "$target"
fi

[[ -d "$target" ]] && echo "$target" > "$target_file"
