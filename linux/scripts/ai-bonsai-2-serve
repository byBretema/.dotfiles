#!/usr/bin/env bash
source "${0%/*}/.bash_common"
set -euo pipefail

################################################################################
### Config
################################################################################

BIN="${HOME}/.local/bin/llama-prism"
MODEL="${HOME}/.local/share/ai_models/Ternary-Bonsai-2-27B/Ternary-Bonsai-2-27B-PQ2_0.gguf"
HOST="127.0.0.1"
PORT="8080"
ALIAS="bonsai"
LOG_DIR="${HOME}/.local/state/llama-prism"
LOG="${LOG_DIR}/serve.log"
READY_TIMEOUT=120

################################################################################
### Ready?
################################################################################

# llama-server /health answers 503 while the model loads, 200 when serving
is_ready() { curl -fsS --max-time 2 "http://${HOST}:${PORT}/health" >/dev/null 2>&1; }

if is_ready; then
    log_info "Already serving => http://${HOST}:${PORT} (alias: ${ALIAS})"
    exit 0
fi

################################################################################
### Start
################################################################################

echo && log_header "Bonsai 2 server"

required_file "${MODEL}"
mkdir -p "${LOG_DIR}"

nohup "${BIN}" serve \
    -m "${MODEL}" \
    --host "${HOST}" \
    --port "${PORT}" \
    --alias "${ALIAS}" \
    -ngl 99 \
    -fa on \
    -c 32768 \
    -np 2 \
    --cache-type-k q8_0 \
    --cache-type-v q4_0 \
    --jinja \
    --metrics \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.05 \
    >"${LOG}" 2>&1 &

log_info "Loading model (up to ${READY_TIMEOUT}s) => ${LOG}"
for ((i = 0; i < READY_TIMEOUT; i++)); do
    if is_ready; then break; fi
    sleep 1
done
is_ready || error_exit "Not ready after ${READY_TIMEOUT}s, check ${LOG}"

log_info "Ready => http://${HOST}:${PORT} (alias: ${ALIAS})"
