#!/usr/bin/env bash
source "${0%/*}/.bash_common"
guard__is_git

branch=$(git symbolic-ref --quiet --short HEAD)
# Prefer the branch's upstream remote, fall back to the first remote
remote=$(git config "branch.${branch}.remote" || git remote | head -n 1)
url=$(git remote get-url "${remote}")

url=${url%.git}
url=${url#ssh://}
if [[ "${url}" != http* ]]; then
  url=${url#*@}
  url="https://${url/://}"
fi

# Detached HEAD opens the repo root
[[ -n "${branch}" ]] && url="${url}/tree/${branch}"

xdg-open "${url}" >/dev/null 2>&1 &
