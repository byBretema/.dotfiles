#!/usr/bin/env bash

# git/hunk diff without AI agent instructions/memory (AGENTS.md, CLAUDE.md, .claude/, ...).
# Usage: code_diff <git|hunk> [diff options/targets] [-- pathspec...]
# Plain `git diff`/`hunk diff` still show everything.

EXCLUDES=(
  "**/AGENTS.md"
  "**/CLAUDE.md"
  "**/CLAUDE.local.md"
  "**/GEMINI.md"
  "**/.cursorrules"
  "**/.github/copilot-instructions.md"
  "**/.claude/**"
  "**/.opencode/**"
  "**/.cursor/**"
  "**/.gemini/**"
  "**/.codex/**"
  "**/.windsurf/**"
  "**/SKILL.md"
  # prompts/commands/templates in non-dot agent config dirs (e.g. dotfiles' configs/claude);
  # md only, so scripts and json there still show up
  "**/claude/**/*.md"
  "**/opencode/**/*.md"
  "**/agents/**/*.md"
)

[[ $1 == git || $1 == hunk ]] || { echo "usage: code_diff <git|hunk> [args...]" >&2; exit 2; }
cmd=("$1" diff)
shift

args=()
specs=()
while (($#)); do
  if [[ $1 == -- ]]; then
    shift
    specs=("$@")
    break
  fi
  args+=("$1")
  shift
done

# :/ = whole repo like plain `git diff`; top = excludes also anchor at the root when run from a subdir
((${#specs[@]})) || specs=(":/")
exec "${cmd[@]}" "${args[@]}" -- "${specs[@]}" "${EXCLUDES[@]/#/:(top,exclude,glob)}"
