#!/usr/bin/env bash
source "${0%/*}/.bash_common"
guard__is_git

git status -s >&2

echo ""
# -z: raw paths (no quoting); rename entries carry the old path as an extra record, skipped
git status --porcelain -z | awk -v RS='\0' 'skip { skip = 0; next } { if ($0 ~ /^R/) skip = 1; print substr($0, 4) }' \
  | choose_one -p "Choose a file" | xargs -r -d '\n' git diff --
