# --- Tools ---

alias j="jobs"
alias oc="opencode"
alias bot='pushd "$(mktemp -d -t bot-XXXXXX)" && opencode'

alias e='$EDITOR'
alias ee='e .'
alias edot='e $DOTFILES'
alias ediff='e $(git ls-files -m -o --exclude-standard)'

alias qc='qtcreator >/dev/null 2>&1'
alias qcc='qtcreator CMakeLists.txt >/dev/null 2>&1'

alias ta='tmux attach || tmux'
alias now='date "+%d/%m/%Y %H:%M"'
alias now_file='date "+%Y-%m-%d_%H-%M"'

alias ytd='yt-dlp'

# --- Langs ---

alias py="python"

# --- List ---

alias l='eza -a --icons auto --git -s type --hyperlink auto'
alias ll='l -l --no-user'
alias l1='l -1'

alias lh='l -1 | head -5'
alias lhh='l -1 | head -10'
alias lhhh='l -1 | head -15'

alias lt='l -1 | tail -5'
alias ltt='l -1 | tail -10'
alias lttt='l -1 | tail -15'

alias T='l -T --ignore-glob=.git'
alias t='T --level=1'
alias tt='T --level=2'
alias ttt='T --level=3'

# --- Navigation ---

alias h='history'
alias yy='yazi'

alias oo='open -s .'
alias b='open -b'
alias s='open -s'
alias d='open -d'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

# --- Dotfiles ---

alias dot='pushd $DOTFILES'
alias doty='dot && y'
alias dotm='$DOTFILES/linux/install.sh'

# --- Git ---

# Movement
alias gt='pushd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)"' # go to repo root
# Status
alias gs='git status --short'
# Management
alias gi='git init'
alias gcl='git clone'
# Diff
alias gd='git diff'
alias gdd='git diff HEAD~1..HEAD'
alias gds='git diff --staged'
alias hd='hunk diff'
# Add
alias ga='git add'
alias gA='git add -A'
alias gap='git add --patch'
# Commit
alias gm='git add -A && gitcommit'
alias gc='gitcommit'
# Push
alias gp='git push'
alias gpnc='git add -A && git commit -m "-"           && git push'
alias gpai='git add -A && git commit -m "AI++"        && git push'
alias gpcm='git add -A && gitcommit --push'
# Pull
alias gu='git pull --rebase'
# Log
alias gl='git lg'
alias gla='git lg --all'
# Branch
alias gb='git branch'
alias gba='git branch -a'
# Switch
alias gsw='git switch'
alias gsc='git switch -c'
# Worktrees
alias gw='git worktree'
alias gwl='git worktree list'
alias gwp='git worktree prune'
alias gwr='git worktree remove'

# --- External agents ---

alias ea='pushd $HOME/agents'
alias eay='pushd $HOME/agents && y'
alias easync='ea && git add -A && git stash && git pull && git stash pop && git commit -m "-" && git push; popd 2>/dev/null'
alias eatree='t $HOME/agents'

# --- Find / Pickers ---

alias ff='fd --hidden --no-ignore-vcs | rg -i'
alias ffi='fd | rg -i'
alias fff='fzf --preview="bat --color=always {}"'

# --- Omi ---

export __DIR__omi="$HOME/omi"

alias om='mkdir -p "$__DIR__omi" && pushd "$__DIR__omi"'
alias omy='om && y'

alias omd='pushd "$__DIR__omi/code/deploy_studio_engine"'
alias omc='pushd "$__DIR__omi/code/studio_engine" && gws'
alias omu="bash $HOME/omi/data/omi_utils.sh"

# alias omn='pushd "$HOME/omi/data/notes"'
# alias omnn="mkdir -p \"$HOME/omi/data/notes\" && hx \"$HOME/omi/data/notes/$(date '+%Y-%m-%d').md\""

# --- Poet ---

export __DIR__poet="$HOME/poet"

alias po='mkdir -p "$__DIR__poet" && pushd "$__DIR__poet"'
alias poy='po && y'
alias pol='pushd "$(ls -1tA "$__DIR__poet" | head -1)" && gws'

# --- Me ---

export __DIR__me="$HOME/me"

alias me='mkdir -p "$__DIR__me" && pushd "$__DIR__me"'
alias mey='me && y'
alias mel='pushd "$(ls -1tA "$__DIR__me" | head -1)" && gws'

# alias brn='pushd \"$HOME/me/notes\"'
# alias brnn="mkdir -p \"$HOME/poet/data/notes\" && hx \"$HOME/poet/data/notes/$(date '+%Y-%m-%d').md\""

# --- Lab ---

export __DIR__lab="$HOME/me/lab"

alias lab='mkdir -p "$__DIR__lab" && pushd "$__DIR__lab"'
alias laby='lab && y'

# --- System ---

alias pbcopy="sed -z 's/^[[:space:]]*//; s/[[:space:]]*\$//' | wl-copy"
alias copyd="pwd | pbcopy"
alias copyf="realpathcopy"

alias pbpaste='wl-paste'

alias rr='gio trash'
alias trash='gio trash'

# --- OpenRGB ---

alias rgbset='openrgb --device 0 --mode static --color'
alias rgblist='openrgb --list-devices'

# --- Kernel info ---

alias jctl='journalctl'
alias qctl='journalctl -p 3 -xb'
