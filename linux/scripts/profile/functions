# Shared bash/zsh functions (fish has its own copies in .fishrc)

# cd into the dir a helper script left in a target file (scripts can't cd the parent shell)
_cd_from_file() {
    local target=$(cat "$1" 2>/dev/null)
    [[ -n "$target" && -d "$target" ]] && cd "$target"
}

# git worktree add/switch + cd
gwa() { git_worktree_add "$@"; _cd_from_file /tmp/git_worktree_add_target; }
gws() { git_worktree_switch "$@"; _cd_from_file /tmp/git_worktree_switch_target; }

# mkdir + cd
mkcd() {
    mkdir -p "$1" && pushd "$1"
}

# yazi, cd to its last dir on exit
y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}
