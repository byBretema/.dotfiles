#!/usr/bin/env bash
source "${0%/*}/.bash_common"


################################################################################
### Parse args
################################################################################

#! Help

usage() {
  show_help <<EOF
Usage: ${script_name} [options] FILEPATH [-- PROGRAM_ARGS...]

Options:
  -g | --gnu    Compile with 'g++' (default)
  -c | --clang  Compile with 'clang++'
  -m | --msvc   Compile with 'cl'
  -s | --std    Set std version (default: 20)
  -h | --help   Show this message
  --            Args after FILEPATH and this go to the program
EOF
  exit 0
}

#! Defaults

compiler="g++"
stdver="20"

#! Process options

while [[ "${#}" > 0 ]]; do
  case "${1}" in
    -g | --gnu   ) shift; compiler="g++" ;;
    -c | --clang ) shift; compiler="clang++" ;;
    -m | --msvc  ) shift; compiler="cl" ;;
    -s | --std   ) shift; stdver="${1}"; shift ;;
    -h | --help  ) shift; usage ;;
    --           ) shift; break ;;
    *            ) break ;;
  esac
done

#! Params

[[ -n "${1:-}" ]] || usage
filepath=$(realpath "$1"); shift
required_file "${filepath}"
[[ "${1:-}" == "--" ]] && shift


################################################################################
### Execution
################################################################################

# private 0700 dir: a shared /tmp path would let other users plant the binary we run
bin_dir=$(mktemp -d -t cpprun.XXXXXXXXXX)
trap 'rm -rf "${bin_dir}"' EXIT
bin_name="${bin_dir}/a.out"

if [[ "${compiler}" == "cl" ]]; then
  bin_name+=".exe"
  cl /nologo /EHsc "/std:c++${stdver}" "${filepath}" "/Fe:${bin_name}" "/Fo:${bin_dir}/" && "${bin_name}" "$@"
else
  "${compiler}" --std="c++${stdver}" "${filepath}" -o "${bin_name}" && "${bin_name}" "$@"
fi
