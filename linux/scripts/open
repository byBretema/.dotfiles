#!/usr/bin/env bash
source "${0%/*}/.bash_common"


################################################################################
### Actions
################################################################################

is_file_or_dir() {
  [[ -f "${1}" ]] ||  [[ -d "${1}" ]] && return 0
  return 1
}

# Files/dirs go to xdg-open, anything else runs as a command; no eval, so names with $(...) stay inert
run() {
  if is_file_or_dir "${1}"; then xdg-open "${1}"; else "$@"; fi
}

silent() {
  run "$@" >/dev/null 2>&1 &
  exit 0
}
detached() {
  run "$@" &
  exit 0
}
block() {
  run "$@"
  exit 0
}


################################################################################
### Parse args
################################################################################

#! Help

usage() {
  echo "Usage: $(basename "${BASH_SOURCE[-1]}") [options] [ITEM_TO_OPEN]"
  echo ""
  echo "Options:"
  echo "  -s | --silent     No log, no block"
  echo "  -d | --detached   Log, no block"
  echo "  -b | --block      Log and block"
  echo "  -h | --help       Show this message"
  echo "  --                Extra args after this"
  exit 1
}

#! Process options

while [[ "${#}" > 0 ]]; do
  case "${1}" in
    -s | --silent   ) shift; silent   "$@" ;;
    -d | --detached ) shift; detached "$@" ;;
    -b | --block    ) shift; block    "$@" ;;
    -h | --help     ) shift; usage ;;
    --              ) shift; break ;;
    *               ) break ;;
  esac
done


################################################################################
### Interactive
################################################################################

OPTIONS=( "Silent" "Detached" "Block" )
option=$(choose_one -p "How to open it?" -- "${OPTIONS[@]}")

[[ "${option}" == "Silent"   ]] && silent   "$@"
[[ "${option}" == "Detached" ]] && detached "$@"
[[ "${option}" == "Block"    ]] && block    "$@"
