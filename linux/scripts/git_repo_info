#!/usr/bin/env bash
# Usage: git_repo_info [DIR]
# Prints "(repo::branch)", "(repo)", "(branch)", "()" or "" (not a git repo)
# Same interpolation logic previously in git_branch_or_symbol:
# repo/branch are omitted when they equal the directory name.

# --- Consts ---

IN_DIR="${1:-$PWD}"
git -C "$IN_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { printf ""; exit 0; }

PWD_BASE="$(basename "$IN_DIR")"
TOP_LEVEL=$(git -C "$IN_DIR" rev-parse --show-toplevel 2>/dev/null)

# --- Vars ---

mark=""
repo_name="$(basename "$TOP_LEVEL")"
branch=$(git -C "$IN_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0

# --- Helpers ---

is_worktree() {
    [[ -d .git/worktrees ]] && [[ -n "$(ls -A .git/worktrees 2>/dev/null)" ]] && return 0
    [[ -f .git ]] && grep -q 'gitdir:' .git 2>/dev/null && return 0
    return 1
}
worktree_branch_match() {
    git -C "$IN_DIR" worktree list | tr -s ' ' | cut -d ' ' -f3 | tr -d '[]' | grep -qxF "$PWD_BASE"
}

show_repo() {
    [[ "$repo_name" != "$PWD_BASE" ]]
}

show_branch() {
    [[ "$branch" != "$PWD_BASE" ]]
}

# --- Logic ---

if is_worktree; then
    repo_name="$(basename "$(dirname "$TOP_LEVEL")")"
    worktree_branch_match || mark=" [non-worktree]"
fi

sep=""
skip_tag=''
show_repo && show_branch && sep="::"

out=""
show_repo && out="$repo_name"
show_branch && out="$out$sep$branch" || out+="$sep"

printf "($out)$mark"
